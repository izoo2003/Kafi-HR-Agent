# Copy this file to .env and fill in real values. Never commit .env.

# --- API ---
# Local: 127.0.0.1. Containers/Railway: leave unset (defaults to 0.0.0.0) or set API_HOST=0.0.0.0
API_HOST=127.0.0.1
API_PORT=8808
# Railway sets PORT automatically; API_PORT is the local fallback.
API_RELOAD=0
# Comma-separated browser origins allowed to call the API (local + Vercel production URL).
CORS_ORIGINS=http://localhost:5288,http://127.0.0.1:5288,https://kafi-hr-agent.vercel.app
# Allow all Vercel preview/production *.vercel.app hosts (set on Railway for frontend deploys).
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Public backend URL (informational; frontend uses this as VITE_API_BASE_URL host).
PUBLIC_API_URL=https://kafi-hr-agent.up.railway.app
ENVIRONMENT=development
APP_VERSION=0.1.0

# --- Database ---
# Local: sqlite:///data/hr_agent_v2.db
# Supabase: postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///data/hr_agent_v2.db

# --- Supabase project (API + Storage for employee/referral files) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Service role key required for private Storage upload/download from the API
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# Private bucket for CNIC images, employee docs, referral attachments (auto-created on boot if missing)
SUPABASE_STORAGE_BUCKET=employee-documents

# --- JWT (change in every non-dev environment) ---
JWT_SECRET_KEY=CHANGE_ME_dev_only_hr_admin_agent
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Seed admin (created on first boot if missing) ---
SEED_ADMIN_EMAIL=admin@kafi-group.com
SEED_ADMIN_PASSWORD=Admin123
SEED_ADMIN_NAME=System Admin

# --- Optional: Gemini (CV scoring / evaluation) ---
# Primary + _2 rotation key per feature. Model fallbacks apply on every key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Sync CVs: route a fetched CV to the best job (open, draft, or closed).
# Falls back to GEMINI_API_KEY pool if empty. Mail IMAP fetch does not need this.
GEMINI_CV_MATCH_API_KEY=
GEMINI_CV_MATCH_API_KEY_2=
GEMINI_CV_MATCH_MODEL=gemini-3.5-flash-lite
GEMINI_CV_MATCH_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# CNIC verification OCR (optional; falls back to GEMINI_API_KEY pool)
GEMINI_CNIC_API_KEY=
GEMINI_CNIC_API_KEY_2=
GEMINI_CNIC_MODEL=gemini-3.5-flash-lite
GEMINI_CNIC_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Education document verification (marks sheet / grade sheet) — separate key
# Falls back to GEMINI_API_KEY pool if empty.
GEMINI_EDUCATION_API_KEY=
GEMINI_EDUCATION_API_KEY_2=
GEMINI_EDUCATION_MODEL=gemini-3.5-flash-lite
GEMINI_EDUCATION_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# --- Job posting AI Analyzer only (description + requirements draft) — separate key ---
GEMINI_JOB_POSTING_API_KEY=your_job_posting_gemini_api_key_here
GEMINI_JOB_POSTING_API_KEY_2=
GEMINI_JOB_POSTING_MODEL=gemini-3.5-flash-lite
GEMINI_JOB_POSTING_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# --- Payroll salary-sheet AI summary (payment modes + narrative) — separate key ---
# Falls back to GEMINI_API_KEY pool if empty. Model chain switches on per-model quota.
GEMINI_PAYROLL_API_KEY=
GEMINI_PAYROLL_API_KEY_2=
GEMINI_PAYROLL_MODEL=gemini-3.5-flash-lite
GEMINI_PAYROLL_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# --- Employee performance monthly AI summary — separate key ---
# Falls back to GEMINI_API_KEY pool if empty.
GEMINI_PERFORMANCE_API_KEY=
GEMINI_PERFORMANCE_API_KEY_2=
GEMINI_PERFORMANCE_MODEL=gemini-3.5-flash-lite
GEMINI_PERFORMANCE_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# --- Employee training course recommendations — separate key ---
# Falls back to GEMINI_API_KEY pool if empty.
GEMINI_TRAINING_API_KEY=
GEMINI_TRAINING_API_KEY_2=
GEMINI_TRAINING_MODEL=gemini-3.5-flash-lite
GEMINI_TRAINING_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Cloudflare Workers AI — Generate an Image for job postings (Railway: set these in env)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_IMAGE_TIMEOUT=120
# Optional branding on the poster
COMPANY_DISPLAY_NAME=Kafi Group
HIRING_APPLY_EMAIL=hr@kafi-group.com

# --- Automated CV intake — Sync CVs uses webmail + Google Form by default ---
# HR webmail IMAP (cPanel). mail.kafi-group.com is Cloudflare-proxied; IMAP
# must connect to the origin MX below (not the orange-cloud A record).
IMAP_HOST=mail.kafi-group.com
IMAP_PORT=993
IMAP_USER=hr@kafi-group.com
IMAP_PASSWORD=
IMAP_SSL=true
# Required on Railway — defaults are baked in for kafi-group.com, but you must set IMAP_PASSWORD.
IMAP_CONNECT_HOST=_dc-mx.32098f035483.kafi-group.com
IMAP_TLS_SERVER_NAME=mail.kafi-group.com

# Enabled Sync CVs sources (comma-separated). Outlook / WhatsApp / Gmail stay off unless listed.
CV_SYNC_SOURCES=webmail,google_form
# Per Sync CVs click: max new rows/emails to import, and max seconds for store + AI matching.
CV_SYNC_BATCH_SIZE=20
CV_SYNC_TIME_BUDGET_SECONDS=120

# Optional Microsoft Graph / Outlook 365 — Azure app with application Mail.Read
OUTLOOK_MAILBOX=hr@kafi-group.com
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Meta WhatsApp Cloud API — display number 03330313511 → +923330313511
WHATSAPP_DISPLAY_NUMBER=+923330313511
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Google Form (required for form CV sync). Gmail API is optional and unused by default.
GMAIL_ADDRESS=hr@kafi-group.com
GOOGLE_OAUTH_CREDENTIALS_FILE=credentials/google_oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/gmail_token.json
# Spreadsheet ID from the form's linked responses Sheet URL (.../spreadsheets/d/<ID>/edit)
GOOGLE_FORM_RESPONSES_SHEET_ID=
# Public Google Form URL shown on job postings (submit details + CV)
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSeUDm87ou1gbO90VPMyrRJYORgHatluwM6xmmUdJgqSZobWmQ/viewform?usp=sharing
GOOGLE_FORM_TOKEN_FILE=credentials/form_token.json
# Paste JSON for cloud deploys (Railway) so files survive redeploys.
# GOOGLE_OAUTH_CLIENT_JSON = contents of google_oauth_client.json
# GOOGLE_FORM_TOKEN_JSON = token printed by: python -m app.ingestion.authorize_google_form
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_FORM_TOKEN_JSON=
GOOGLE_OAUTH_TOKEN_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Minimum AI match confidence (0-1) to auto-assign a fetched CV to a job; below this it stays unassigned.
CV_AUTO_MATCH_MIN_CONFIDENCE=0.55

# LinkedIn — same developer app + member tokens. Open a job posting to pick
# which profiles get a feed post (Khalid / Sadia / Adil).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ACCOUNT_1_LABEL=
LINKEDIN_ACCOUNT_2_ACCESS_TOKEN=
LINKEDIN_ACCOUNT_2_LABEL=
LINKEDIN_ACCOUNT_3_ACCESS_TOKEN=
LINKEDIN_ACCOUNT_3_LABEL=
# YYYYMM, e.g. 202608. Leave blank to use the current month automatically.
LINKEDIN_API_VERSION=
