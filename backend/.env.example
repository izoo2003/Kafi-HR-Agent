# Copy this file to .env and fill in real values. Never commit .env.

# --- Gemini (LLM scoring) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# --- Gmail ingestion ---
# hr@kafi-group.com inbox is read via Gmail API (OAuth). See README for setup.
GMAIL_ADDRESS=hr@kafi-group.com
GOOGLE_OAUTH_CREDENTIALS_FILE=credentials/google_oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/gmail_token.json

# --- Google Form ingestion (via linked Google Sheet + Drive) ---
GOOGLE_FORM_RESPONSES_SHEET_ID=your_google_sheet_id_here
GOOGLE_FORM_TOKEN_FILE=credentials/form_token.json

# --- Database ---
DATABASE_URL=sqlite:///data/hr_agent.db

# --- Reporting ---
REPORTS_OUTPUT_DIR=data/reports

# --- API server ---
# Dedicated ports for this HR Agent project (not 8000/8080 used by other apps).
API_HOST=127.0.0.1
API_PORT=8808
API_RELOAD=0
