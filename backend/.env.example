# Copy this file to .env and fill in real values. Never commit .env.

# --- API ---
# Local: 127.0.0.1. Containers/Railway: leave unset (defaults to 0.0.0.0) or set API_HOST=0.0.0.0
API_HOST=127.0.0.1
API_PORT=8808
# Railway sets PORT automatically; API_PORT is the local fallback.
API_RELOAD=0
# Comma-separated browser origins allowed to call the API (local + Vercel production URL).
CORS_ORIGINS=http://localhost:5288,http://127.0.0.1:5288,https://kafi-hr-agent.vercel.app
# Allow all Vercel preview/production *.vercel.app hosts (set on Railway for frontend deploys).
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Public backend URL (informational; frontend uses this as VITE_API_BASE_URL host).
PUBLIC_API_URL=https://kafi-hr-agent.up.railway.app
ENVIRONMENT=development
APP_VERSION=0.1.0

# --- Database ---
# Local: sqlite:///data/hr_agent_v2.db
# Supabase: postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///data/hr_agent_v2.db

# --- Supabase project (API / future Auth) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# --- JWT (change in every non-dev environment) ---
JWT_SECRET_KEY=CHANGE_ME_dev_only_hr_admin_agent
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Seed admin (created on first boot if missing) ---
SEED_ADMIN_EMAIL=admin@kafi-group.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_ADMIN_NAME=System Admin

# --- Optional: Gemini (CV↔job matching + evaluation rating /10 + why accept/reject) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# CNIC verification OCR (optional; falls back to GEMINI_API_KEY)
GEMINI_CNIC_API_KEY=
GEMINI_CNIC_MODEL=gemini-flash-latest

# --- Job posting AI Analyzer only (description + requirements draft) — separate key ---
GEMINI_JOB_POSTING_API_KEY=your_job_posting_gemini_api_key_here
GEMINI_JOB_POSTING_MODEL=gemini-flash-latest

# --- Automated CV intake — all optional; sync reports "not configured" per source if blank ---
# HR webmail IMAP (cPanel / mail.kafi-group.com) — primary for hr@kafi-group.com
IMAP_HOST=mail.kafi-group.com
IMAP_PORT=993
IMAP_USER=hr@kafi-group.com
IMAP_PASSWORD=
IMAP_SSL=true

# Optional Microsoft Graph / Outlook 365 — Azure app with application Mail.Read
OUTLOOK_MAILBOX=hr@kafi-group.com
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Meta WhatsApp Cloud API — display number 03330313511 → +923330313511
WHATSAPP_DISPLAY_NUMBER=+923330313511
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Optional legacy Gmail path (only if mailbox is actually Gmail / Google Workspace)
GMAIL_ADDRESS=hr@kafi-group.com
GOOGLE_OAUTH_CREDENTIALS_FILE=credentials/google_oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/gmail_token.json
# Spreadsheet ID from the form's linked responses Sheet URL (.../spreadsheets/d/<ID>/edit)
GOOGLE_FORM_RESPONSES_SHEET_ID=
# Public Google Form URL shown on job postings (submit details + CV)
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSeUDm87ou1gbO90VPMyrRJYORgHatluwM6xmmUdJgqSZobWmQ/viewform?usp=sharing
GOOGLE_FORM_TOKEN_FILE=credentials/form_token.json
# Paste the minted token JSON contents here for cloud deploys (Railway) so it survives redeploys.
GOOGLE_OAUTH_TOKEN_JSON=
# Minimum AI match confidence (0-1) to auto-assign a fetched CV to a job; below this it stays unassigned.
CV_AUTO_MATCH_MIN_CONFIDENCE=0.55
